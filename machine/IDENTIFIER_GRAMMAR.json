    "N-GEN-001",
    "CYCLE-1",
    "assurance:TEST-001",
    "T_N_043"
  ],
  "grammar_id": "BOIS-IDENTIFIER-GRAMMAR-1.0",
  "package_id": "v2.31_Public_BOIS_Common_Core",
  "pattern": "^[A-Za-z][A-Za-z0-9]*(?:[-_.:][A-Za-z0-9]+)*$",
  "release_level_naming": {

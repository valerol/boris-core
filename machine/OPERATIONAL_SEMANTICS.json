        "empty_collection": "TRUE (vacuous universal quantification)",
        "missing_child_path": "UNKNOWN unless a prior item already produced FALSE",
        "missing_collection_path": "UNKNOWN",
        "result": "Four-valued TRUE/FALSE/UNKNOWN/ERROR as defined above.",
        "short_circuit": "FALSE on first typed inequality; otherwise UNKNOWN if at least one child is missing; TRUE only when every item is typed-equal",
        "signature": {
          "child_path": "string",
          "equals": "typed scalar",
          "path": "string"
        },
        "typed_equality": "type(actual) == type(expected) and actual == expected",
        "wrong_collection_type": "ERROR"
      },
